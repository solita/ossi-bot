{
  "name": "os-contribution-slack-bot",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "cdk": "cdk",
    "bootstrap": "cdk bootstrap --force --qualifier ossi-bot --toolkit-stack-name ossi-bot-cdk-toolkit-stack --bootstrap-bucket-name ossi-bot-bootstrap-assets --verbose",
    "build": "tsc --build",
    "lint": "tslint --fix \"src/**/*.ts\" --project tsconfig.json",
    "test": "jest --runInBand --config jest.config.unit.js",
    "tsc": "tsc"
  },
  "author": "Juho Friman <juho.friman@solita.fi>",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/types": "^3.974.4",
    "@types/aws-lambda": "^8.10.162",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.0.0",
    "aws-cdk": "^2.1138.0",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^15.5.2",
    "ts-jest": "^29.4.12",
    "tslint": "^5.20.1",
    "tslint-config-airbnb": "^5.11.2",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1113.0",
    "@aws-sdk/client-dynamodb": "^3.1113.0",
    "@aws-sdk/client-lambda": "^3.1113.0",
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/client-secrets-manager": "^3.1113.0",
    "@aws-sdk/cloudfront-signer": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@slack/web-api": "^8.0.0",
    "@smithy/config-resolver": "^4.7.2",
    "@smithy/node-config-provider": "^4.6.2",
    "aws-cdk-lib": "^2.266.0",
    "axios": "^1.19.0",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.6",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.3",
    "source-map-support": "^0.5.21",
    "xlsx": "^0.18.5"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/out/",
      "/integration/types/",
      "/.build/"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "moduleDirectories": [
      "node_modules",
      "."
    ],
    "collectCoverage": true,
    "coverageReporters": [
      "lcov",
      "text",
      "html"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "tslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
